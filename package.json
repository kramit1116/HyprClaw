{
  "name": "hyprclaw",
  "version": "0.1.0",
  "description": "A terminal and Telegram coding assistant powered by OpenRouter.",
  "type": "module",
  "bin": {
    "hyprclaw": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run index.ts",
    "check": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build ./index.ts --bundle --target=node --outfile ./dist/cli.js",
    "prepack": "bun run check && bun run build",
    "prepublishOnly": "bun run check && bun run test && bun run build"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "cli",
    "coding-agent",
    "telegram",
    "openrouter"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/marked-terminal": "^6.1.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@clack/core": "^1.4.2",
    "@clack/prompts": "^1.6.0",
    "@mendable/firecrawl-js": "^4.32.2",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "ai": "^7.0.15",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "figlet": "^1.11.0",
    "marked": "^18.0.6",
    "marked-terminal": "^7.3.0",
    "telegraf": "^4.16.3",
    "zod": "^3.25.76"
  }
}
