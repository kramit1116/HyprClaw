# Optional: run `hyprclaw configure` instead of creating this file.
# Environment variables override saved configuration.

OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openrouter/free

# Required only for Telegram mode. TELEGRAM_OWNER_ID is your numeric user ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Optional: enables web research in Ask and Plan modes.
FIRECRAWL_API_KEY=
